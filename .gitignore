# --- Python / project ---
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Runtime read-model artifacts (disposable projections, never committed)
*.db
*.db-wal
*.db-shm

# Agent/tooling state — never commit
.claude/
.guardkit/

# --- macOS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon
.DocumentRevisions-V100
.fseventsd
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# The composed read-model volume (projection history — never committed)
/data/

# The projector's NATS credential (see .env.example) — never committed
.env

# Secrets: the whole .env family, not just the exact name. A timestamped backup
# (.env.bak-pre-brief-20260717) once leaked live credentials because the single
# line '.env' matches only itself, so the backup rode along in a commit.
# The '!' lines keep the checked-in example/sample files working.
.env.*
*.env
!.env.example
!.env.sample
!*.env.example
!*.env.sample
